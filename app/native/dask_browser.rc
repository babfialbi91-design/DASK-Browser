// DASK Browser - Windows resource script (icon + version info).
#include <windows.h>
#include "version.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winver.h"
#undef APSTUDIO_READONLY_SYMBOLS

// Icon resource id 1: the normal app icon from DASK_Browser_Icon_Pack.
// Numeric id so LoadIconW(hInstance, MAKEINTRESOURCEW(1)) finds it.
1 ICON "C:/Users/asfkep/.deepai-code/scratch/2026-11-25-dask-browser-01-foundation-md-777b6a7d/app/native/branding/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DASK_VERSION_MAJOR,DASK_VERSION_MINOR,DASK_VERSION_PATCH,0
 PRODUCTVERSION DASK_VERSION_MAJOR,DASK_VERSION_MINOR,DASK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DASK"
            VALUE "FileDescription", "DASK Browser"
            VALUE "FileVersion", DASK_VERSION_STRING
            VALUE "ProductName", "DASK Browser"
            VALUE "ProductVersion", DASK_VERSION_STRING
            VALUE "OriginalFilename", "dask_browser.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
